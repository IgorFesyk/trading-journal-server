enum CATEGORY {
    FOREX   @map("forex")
    CRYPTO  @map("crypto")
    STOCKS  @map("stocks")
    INDICES @map("indices")
}

model Symbol {
    id        Int      @id @default(autoincrement())
    name      String   @unique
    category  CATEGORY
    published Boolean  @default(true)
    trades    Trade[]

    @@map("symbols")
}
