enum TRADE_STATUS {
    WIN         @map("win")
    LOSE        @map("lose")
    BE          @map("be")
    IN_PROGRESS @map("in-progress")
}

enum DIRECTION {
    LONG  @map("long")
    SHORT @map("short")
}

enum TIMEFRAME {
    M15 @map("m15")
    H1  @map("h1")
    H4  @map("h4")
    D1  @map("d1")
    W1  @map("w1")
}

enum EXECUTION_SETUP {
    IDM         @map("idm")
    SNR         @map("snr")
    FVG         @map("fvg")
    MarketEntry @map("market-entry")
}

model Trade {
    id           Int              @id @default(autoincrement())
    account      Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
    accountId    Int              @map("account_id")
    symbol       Symbol           @relation(fields: [symbolId], references: [id])
    symbolId     Int              @map("symbol_id")
    pnl          Int?             // cents: $10,50 -> 1050
    risk         Int              // pips: 1,52% -> 152
    commission   Int?             // cents: $12,4 -> 1240
    status       TRADE_STATUS
    direction    DIRECTION
    entryTF      TIMEFRAME        @map("entry_tf")
    setup        EXECUTION_SETUP
    notes        String?
    openedAt     DateTime         @map("opened_at")
    closedAt     DateTime?        @map("closed_at")
    createdAt    DateTime         @default(now()) @map("created_at")
    updatedAt    DateTime         @updatedAt @map("updated_at")

    @@index([accountId, openedAt])
    @@index([accountId, closedAt])
    @@index([accountId, status])
    @@index([symbolId])
    @@map("trades")
}
