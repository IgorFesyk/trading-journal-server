enum ACCOUNT_TYPE {
    CAPITAL
    PROP
}

enum CURRENCY {
    USD
    EUR
    GBP
}

model Account {
    id             Int           @id @default(autoincrement())
    user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId         Int           @map("user_id")
    name           String
    type           ACCOUNT_TYPE
    currency       CURRENCY
    trades         Trade[]
    transactions   Transaction[]
    startingEquity Int           @map("starting_equity") // cents: $10.000 -> 10.000.00
    targetEquity   Int?          @map("target_equity")   // cents: $15.000 -> 15.000.00
    createdAt      DateTime      @default(now()) @map("created_at")
    updatedAt      DateTime      @updatedAt @map("updated_at")

    @@unique([userId, name])
    @@index([userId])
    @@map("accounts")
}
