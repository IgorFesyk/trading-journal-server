enum ACCOUNT_TYPE {
    CAPITAL     @map("capital")
    PROP        @map("prop")
}

enum CURRENCY {
    USD     @map("usd")
    EUR     @map("eur")
    GBP     @map("gbp")
}

model Account {
    id             Int           @id @default(autoincrement())
    user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId         Int           @map("user_id")
    name           String        @unique
    type           ACCOUNT_TYPE
    currency       CURRENCY
    trades         Trade[]
    transactions   Transaction[]
    startingEquity Int           @map("starting_equity") // cents: $10.000 -> 10.000.00
    targetEquity   Int?          @map("target_equity")   // cents: $15.000 -> 15.000.00
    createdAt      DateTime      @default(now()) @map("created_at")
    updatedAt      DateTime      @updatedAt @map("updated_at")

    @@unique([userId, name])
    @@map("accounts")
}
