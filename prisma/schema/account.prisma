enum ACCOUNT_TYPE {
    CAPITAL
    PROP
}

enum CURRENCY {
    USD
    EUR
    GBP
}

model Account {
    id             Int           @id @default(autoincrement())
    user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId         Int
    name           String
    type           ACCOUNT_TYPE
    currency       CURRENCY
    trades         Trade[]
    transactions   Transaction[]
    startingEquity Int           // cents: $10.000 -> 10.000.00
    targetEquity   Int?          // cents: $15.000 -> 15.000.00
    createdAt      DateTime      @default(now())
    updatedAt      DateTime      @updatedAt

    @@unique([userId, name])
    @@index([userId])
}
